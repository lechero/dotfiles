source <(fzf --zsh)

eval "$(zoxide init zsh)"
eval "$(starship init zsh)"

alias ll='ls -l'
alias la='ls -A'
alias l='ls -CF'
alias ".."='cd ..'
alias "..."='cd ../..'
alias "...."='cd ../../..'
alias qq="exit"
alias v="nvim"
alias cls="clear"
alias lg="lazygit"

# This machine's own setup, like PATH entries that tools add. Not tracked:
# see .chezmoiignore.
[[ -r "$HOME/.config/shell/local.sh" ]] && source "$HOME/.config/shell/local.sh"

# SDKMAN, where it's installed. This must stay at the end of the file. Only
# exported then: fish started from here would warn about an empty SDKMAN_DIR.
if [[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]]; then
  export SDKMAN_DIR="$HOME/.sdkman"
  source "$HOME/.sdkman/bin/sdkman-init.sh"
fi

